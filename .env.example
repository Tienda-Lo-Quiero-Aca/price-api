PORT=3000
# Con production solo se loguean error y warn.
NODE_ENV=development

# Clave que deben enviar los consumidores en x-api-key.
# Sin definir, el servicio acepta local-dev-api-key: en produccion tiene que estar.
API_KEY=

# Madre: producto (precio en Amazon y peso), categoria del SKU e impuestos.
MADRE_API_BASE_URL=
MADRE_INTERNAL_API_KEY=

# meli-api: comision de Mercado Libre.
MELI_API_BASE_URL=https://api.meli.loquieroaca.com
MELI_API_KEY=
MELI_API_KEY_HEADER=x-api-key

# Swagger
SWAGGER_PATH=/api/docs

# Sitio de documentacion (README + docs/). Sin usuario y clave queda abierto y
# no publica la pagina de operacion; con los dos pide credenciales y publica todo.
DOCS_SITE_ENABLED=true
DOCS_SITE_PATH=/docs
# DOCS_SITE_USER=
# DOCS_SITE_PASSWORD=
